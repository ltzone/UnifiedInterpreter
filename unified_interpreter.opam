# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "A small OCaml 5 effect-based multi-level IR interpreter demo"
depends: [
  "ocaml" {>= "5.0"}
  "dune" {>= "3.11"}
  "rocq-prover"
  "rocq-stdpp" {= "1.13.0"}
  "coq-ext-lib" {= "0.13.1"}
  "coq-itree" {= "5.2.1"}
  "rocq-coinduction" {= "1.21"}
  "zarith"
  "yojson"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
